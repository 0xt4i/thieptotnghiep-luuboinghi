generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Guest {
  id            String   @id @default(cuid())
  token         String   @unique
  name          String
  salutation    String
  group         String
  contact       String?
  personalNote  String?
  checkedIn     Boolean  @default(false)
  createdAt     DateTime @default(now())
  rsvp          Rsvp?
}

model Rsvp {
  id         String   @id @default(cuid())
  guestId    String   @unique
  status     String
  companions Int      @default(0)
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model EventSchedule {
  id          Int    @id @default(1)
  familyTime  String?
  familyEnd   String?
  friendsTime String?
  friendsEnd  String?
  otherTime   String?
  otherEnd    String?
}

model EventContact {
  id        String @id @default(cuid())
  name      String
  phone     String
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())
}

model EventSetting {
  id       Int    @id @default(1)
  deadline String
}
